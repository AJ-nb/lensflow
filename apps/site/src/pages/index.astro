---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const capabilities = ["图片捕捉", "画面解构", "反推提示词", "提示词变体", "色卡", "姿态参考", "划词收藏", "批量生成", "五轴抽卡", "卡池揭示", "四类资产", "历史与任务", "下载与 Eagle"];
const faq = [
  ["为什么网页 Studio 需要插件？", "Provider 请求、API Key 和本地数据库都由插件持有。网页只通过受限桥接调用允许的方法。"],
  ["是否支持兼容接口？", "支持自定义 OpenAI-compatible Base URL、彼源预设和 ComfyUI API-workflow。能力以真实检测结果为准。"],
  ["会跨设备同步吗？", "不会。同步仅指同一台设备上的网页与插件实时共享本地资产和任务。"],
  ["图片会上传吗？", "本地测量不会上传；只有你明确执行分析、生成或编辑时，确认的内容才发送到所选 Provider。"],
  ["Eagle 是必需的吗？", "不是。Eagle 只在主动保存时连接，离线不会影响本地下载和历史。"]
];
---
<SiteLayout title="镜序 Lensflow｜本地 AI 创作工作台" description="从网页灵感到可复用创作资产的本地 AI 工作台">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "SoftwareApplication", name: "镜序 Lensflow", applicationCategory: "DesignApplication", operatingSystem: "Windows, macOS", offers: { "@type": "Offer", price: "0", priceCurrency: "CNY" }, softwareRequirements: "Chrome 122+" })} />
  <main>
    <section class="hero-band">
      <div class="hero-copy">
        <span class="eyebrow">LOCAL AI CREATIVE WORKBENCH</span>
        <h1>镜序 Lensflow</h1>
        <p>从网页灵感到可复用创作资产的本地 AI 工作台</p>
        <div class="hero-actions"><a class="button primary" data-install-cta data-install-state="checking" aria-busy="true" href={`${base}/download`}>检测中</a><a class="button" href="#workflow">查看完整工作流</a></div>
      </div>
      <figure class="hero-media">
        <picture>
          <source media="(max-width: 600px)" srcset={`${base}/media/studio-mobile.webp`} />
          <img src={`${base}/media/studio-overview.webp`} width="1440" height="1024" alt="Lensflow 创作工作台，展示本地素材、四步流程和 Provider 状态" />
        </picture>
      </figure>
    </section>

    <section class="trust-strip" aria-label="产品差异"><div><strong>无需账号</strong><span>安装后即可使用</span></div><div><strong>Key 由你掌控</strong><span>默认只在会话存储</span></div><div><strong>资产保存在本机</strong><span>无云数据库</span></div><div><strong>源码公开</strong><span>MIT，可审查</span></div></section>

    <section class="workflow-band" id="workflow"><header><span class="eyebrow">THREE-STAGE FLOW</span><h2>灵感不是终点，复用才是</h2><p>从网页捕捉开始，在同一条本地链路里完成理解、组合、生成和归档。</p></header><div class="workflow-grid"><article><span>01</span><h3>网页捕捉与解构</h3><p>悬浮 P/V、右键操作、本地测量、结构化解构和自然语言反推。</p><small>输入：网页或本地图片</small><strong>结果：捕捉图、色卡、提示词</strong></article><article><span>02</span><h3>组合与批量创作</h3><p>五轴抽卡、词卡托盘、参考关系、能力预检和 1–10 张批量生成。</p><small>动作：组合、锁定、预检</small><strong>结果：可补全的生成批次</strong></article><article><span>03</span><h3>资产沉淀与复用</h3><p>扇形卡池揭示、历史留存、作品显式保存、下载、备份与 Eagle。</p><small>规则：历史自动、作品主动</small><strong>结果：四类本地资产</strong></article></div></section>

    <section class="capability-band"><header><span class="eyebrow">13 VERIFIED CAPABILITIES</span><h2>覆盖公开工作流，不复制私有实现</h2></header><div class="capability-list">{capabilities.map((item, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><strong>{item}</strong></div>)}</div></section>

    <section class="start-band"><header><span class="eyebrow">GET STARTED</span><h2>三步开始</h2></header><ol><li><span>1</span><div><strong>安装插件</strong><p>从固定目录加载 ZIP，或使用未来的商店版本。</p></div></li><li><span>2</span><div><strong>配置 Provider</strong><p>填写完整 Base URL 和自己的 API Key，发现模型并检查能力。</p></div></li><li><span>3</span><div><strong>从自己的内容开始</strong><p>捕捉网页图片、上传图片，或手动建立关键词库。</p></div></li></ol></section>

    <section class="privacy-band"><div><span class="eyebrow">LOCAL-FIRST</span><h2>网页看不到你的 API Key</h2><p>密钥由插件后台保存和使用。网页桥接只允许资产、任务、下载和备份方法，并校验 Origin、协议版本、nonce、请求 ID 与负载大小。</p><a href={`${base}/privacy`}>查看完整数据流</a></div><dl><div><dt>始终留在本机</dt><dd>API Key、历史、资产、设置元数据</dd></div><div><dt>按操作发送</dt><dd>提示词、已确认的图片与参考内容</dd></div><div><dt>永不进入备份</dt><dd>API Key、浏览历史、任意文件权限</dd></div></dl></section>

    <section class="faq-band"><header><span class="eyebrow">FAQ</span><h2>常见问题</h2></header><div>{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  </main>
</SiteLayout>
