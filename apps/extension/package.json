{
  "name": "@lensflow/extension",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/verify-manifest.mjs && node scripts/sync-chrome-output.mjs",
    "zip": "wxt zip && node scripts/sync-chrome-output.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "prompt:eval": "npx --yes promptfoo@0.122.0 eval -c promptfoo/promptfooconfig.json",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@lensflow/contracts": "0.3.3",
    "@lensflow/core": "0.3.3",
    "@lensflow/ui": "0.3.3",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "colorthief": "^3.5.0",
    "culori": "^4.0.2",
    "dexie": "^4.4.4",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "wxt": "^0.21.3"
  }
}
